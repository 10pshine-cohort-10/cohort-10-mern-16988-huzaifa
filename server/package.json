{
  "name": "@shine/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').copyFileSync('src/schema.sql','dist/schema.sql')\"",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "db:migrate": "tsx --env-file-if-exists=../.env src/migrate.ts",
    "test": "mocha --import=tsx \"test/**/*.test.ts\"",
    "coverage": "c8 mocha --import=tsx \"test/**/*.test.ts\"",
    "test:postgres": "tsx --env-file-if-exists=../.env test/postgres-smoke.ts"
  },
  "dependencies": {
    "express": "5.3.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "helmet": "8.3.0",
    "express-rate-limit": "8.7.4",
    "cookie-parser": "1.4.7",
    "sanitize-html": "2.18.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "mocha": "12.0.3",
    "chai": "6.3.0",
    "supertest": "7.3.2",
    "c8": "12.0.0",
    "@types/node": "26.6.6",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/cookie-parser": "1.4.10",
    "@types/sanitize-html": "2.16.2",
    "@types/mocha": "10.0.10",
    "@types/chai": "5.2.3",
    "@types/supertest": "7.2.1",
    "@electric-sql/pglite": "0.5.16"
  }
}
